{
  "name": "dsh-learning-todo",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "A learning task list in the DSH left sidebar: add tasks, tick them off, and archive completed ones into a read-only list stored in this browser.",
  "license": "MIT",
  "author": "NomanLord",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NomanLord/dsh-learning-todo.git"
  },
  "homepage": "https://github.com/NomanLord/dsh-learning-todo#readme",
  "bugs": {
    "url": "https://github.com/NomanLord/dsh-learning-todo/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "todo",
    "tasks"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
